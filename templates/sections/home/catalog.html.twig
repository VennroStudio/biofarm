<section id="catalog" class="scroll-mt-24 pb-8 md:pb-12" aria-labelledby="home-catalog-heading" data-home-catalog>
    <div class="container mx-auto px-5 md:px-8 lg:px-12">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <h2 id="home-catalog-heading" tabindex="-1" class="text-3xl font-normal text-primary md:text-[42px]">Наша продукция</h2>
            <a href="/catalog" class="shrink-0 text-sm text-primary hover:underline">Весь каталог <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
        <p data-home-catalog-status role="status" class="sr-only"></p>
        <div data-home-catalog-results>
            {% include 'sections/home/catalog-content.html.twig' with { catalog: catalog } only %}
        </div>
    </div>
</section>

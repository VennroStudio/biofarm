APP_ENV=dev
APP_URL=https://biofarm.local
APP_DEBUG=1
APP_SECRET=change-me-in-local-development-secret

HTTP_PORT=8088

DB_HOST=mariadb-container
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=biofarm
DB_CHARSET=utf8mb4

MAILER_HOST=mail.hosting.reg.ru
MAILER_PORT=465
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=Biofarm

# false: no application data cache; true: Redis server and PHP redis extension required.
REDIS=false
REDIS_HOST=redis-container
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

FRONTEND_URL=https://biofarm.local
FRONTEND_AUTH_URL=https://auth.biofarm.local

JWT_SECRET=change-me-in-local-development-jwt-secret

COOKIE_DOMAIN=.biofarm.local
COOKIE_SECURE=false

UPLOADS_PUBLIC_PATH=/uploads
UPLOADS_STORAGE_PATH=/app/public/uploads

CHECKBUG_DSN=
YANDEX_DISK_TOKEN=

# YooKassa payment acceptance. Payouts remain manual.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Path appended to FRONTEND_URL, not a full URL.
YOOKASSA_RETURN_BASE_URL=/order-success
# Enable only after choosing the fiscal receipt workflow for the shop.
YOOKASSA_RECEIPTS_ENABLED=0
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=0
# Enable after the cash register is configured for marked goods and FFD 1.2.
YOOKASSA_FFD12_ENABLED=0
# FNS cash register timezone code, 1..11. Tomsk (UTC+7) is 6.
YOOKASSA_RECEIPT_TIMEZONE=0

# Ozon Seller catalog. Register this exact callback URL in the private app.
OZON_CLIENT_ID=
OZON_CLIENT_SECRET=
OZON_SELLER_ID=
OZON_REDIRECT_URI=
# Random URL-safe string of at least 32 characters.
OZON_WEBHOOK_SECRET=
# Full sync starts at 03:00 in this timezone after the first manual import.
OZON_SYNC_TIMEZONE=Asia/Krasnoyarsk

# Production FBO pickup checkout. Reconnect OAuth to grant logistics, FBO and return scopes.
OZON_DELIVERY_ENABLED=0

# Phone confirmation and sign-in at checkout.
CHECKOUT_PHONE_VERIFICATION_ENABLED=0
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=
SMSAERO_CALLBACK_URL=
# Comma-separated proxy addresses whose X-Real-IP header is trusted for SMS limits.
SMSAERO_TRUSTED_PROXIES=

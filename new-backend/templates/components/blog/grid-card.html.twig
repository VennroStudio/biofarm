{% set compact = compact|default(false) %}
<article class="h-full">
    <a href="/blog/{{ post.slug }}" class="group flex h-full flex-col rounded-3xl border border-border bg-card p-3 transition-colors hover:border-primary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4">
        <div class="relative overflow-hidden rounded-2xl {{ compact ? 'aspect-[16/7]' : 'aspect-[16/10]' }}">
            {{ optimized_image(post.image, post.imageAlt ?: post.title, {
                class: 'h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105',
                loading: 'lazy',
                decoding: 'async'
            }) }}
            <span class="absolute left-3 top-3 rounded-full bg-white px-3 py-1.5 text-xs text-primary">{{ post.category }}</span>
        </div>
        <div class="flex flex-1 flex-col px-2 pb-2 pt-5 md:px-3">
            <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                <span>{{ post.date }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ post.readTime }} мин чтения</span>
            </div>
            <h3 class="font-normal leading-snug text-foreground transition-colors group-hover:text-primary {{ compact ? 'text-xl' : 'text-2xl' }}">{{ post.title }}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground {{ compact ? 'line-clamp-2' : 'line-clamp-3' }}">{{ post.excerpt }}</p>
            <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                <div class="flex items-center gap-2">
                    {% if post.authorAvatar %}
                        {{ optimized_image(post.authorAvatar, post.authorName, {
                            class: 'h-8 w-8 rounded-full object-cover',
                            loading: 'lazy',
                            decoding: 'async'
                        }) }}
                    {% endif %}
                    <span class="text-xs text-muted-foreground">{{ post.authorName }}</span>
                </div>
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-secondary text-primary transition-colors group-hover:bg-primary group-hover:text-white">
                    <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                </span>
            </div>
        </div>
    </a>
</article>

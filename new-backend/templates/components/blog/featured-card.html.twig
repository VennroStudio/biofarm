<article class="h-full">
    <a href="/blog/{{ post.slug }}" class="group flex h-full flex-col overflow-hidden rounded-3xl bg-secondary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-4">
        <div class="relative min-h-64 flex-1 overflow-hidden md:min-h-80">
            {{ optimized_image(post.image, post.imageAlt ?: post.title, {
                class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-105',
                loading: 'eager',
                fetchpriority: 'high',
                decoding: 'async'
            }) }}
            <span class="absolute left-5 top-5 rounded-full bg-white px-4 py-2 text-xs uppercase tracking-widest text-primary md:left-7 md:top-7">
                {{ post.category }}
            </span>
        </div>
        <div class="p-6 md:p-8 xl:p-10">
            <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground md:text-sm">
                <span>{{ post.date }}</span>
                <span aria-hidden="true">·</span>
                <span>{{ post.readTime }} мин чтения</span>
            </div>
            <h2 class="max-w-3xl text-3xl font-normal leading-tight tracking-tight text-foreground transition-colors group-hover:text-primary md:text-4xl">
                {{ post.title }}
            </h2>
            <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">{{ post.excerpt }}</p>
            <div class="mt-7 flex items-center justify-between gap-4 border-t border-primary/15 pt-5">
                <div class="flex min-w-0 items-center gap-3">
                    {% if post.authorAvatar %}
                        {{ optimized_image(post.authorAvatar, post.authorName, {
                            class: 'h-10 w-10 shrink-0 rounded-full object-cover',
                            loading: 'lazy',
                            decoding: 'async'
                        }) }}
                    {% endif %}
                    <span class="text-sm text-foreground">{{ post.authorName }}</span>
                </div>
                <span class="flex shrink-0 items-center gap-3 text-sm text-primary">
                    Читать статью
                    <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
            </div>
        </div>
    </a>
</article>

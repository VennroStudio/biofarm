{% if purposes is not empty %}
<div data-purpose-tiles>
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-2xl font-normal text-primary md:text-3xl">Для чего подбираете продукт?</h2>
        <p class="text-sm text-muted-foreground">Выберите направление заботы</p>
    </div>
    <nav class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 2xl:grid-cols-7" aria-label="Назначения продуктов">
        {% for purpose in purposes %}
            {% set selected = activeSlug == purpose.slug %}
            <a href="{{ urls[purpose.slug] }}" data-purpose-tile="{{ purpose.slug }}" {% if selected %}aria-current="true"{% endif %}
               class="group flex min-h-32 md:min-h-36 min-w-0 flex-col justify-between gap-4 rounded-2xl border p-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:p-5 {{ selected ? 'border-primary bg-primary text-white' : 'border-primary/15 bg-secondary/30 text-primary hover:border-primary/50 hover:bg-secondary' }}">
                <div class="flex items-start justify-between gap-2">
                    {% include 'components/product/purpose-icon.html.twig' with { slug: purpose.slug } only %}
                    {% if selected %}<span class="text-lg leading-none" aria-hidden="true">✓</span>{% else %}<span class="text-xs text-muted-foreground">{{ purpose.productsCount }}</span>{% endif %}
                </div>
                <div class="flex items-end justify-between gap-2">
                    <span class="min-w-0 break-words text-[13px] font-medium leading-snug sm:text-sm md:text-base {{ selected ? 'text-white' : 'text-foreground' }}">{{ purpose.name }}</span>
                    <svg class="hidden h-4 w-4 shrink-0 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
                </div>
            </a>
        {% endfor %}
        <a href="{{ allUrl }}" class="flex min-h-32 md:min-h-36 flex-col justify-between gap-4 rounded-2xl border border-dashed border-primary/30 bg-white p-4 text-primary transition-colors hover:border-primary hover:bg-secondary/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:p-5">
            {% include 'components/product/purpose-icon.html.twig' with { slug: 'all' } only %}
            <span class="flex items-end justify-between gap-2 text-sm font-medium leading-snug md:text-base">Все назначения <span aria-hidden="true">↗</span></span>
        </a>
    </nav>
</div>
{% endif %}

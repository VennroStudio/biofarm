<button type="button" class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-full border border-input bg-background text-foreground transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-60 {{ compact|default(false) ? 'w-11' : 'px-4 text-sm' }} [&[aria-pressed=true]_svg]:fill-current" data-favorite-button data-product-id="{{ productId }}" aria-label="Добавить в избранное" aria-pressed="false" title="Добавить в избранное">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>
    {% if not compact|default(false) %}<span data-favorite-label>В избранное</span>{% endif %}
</button>

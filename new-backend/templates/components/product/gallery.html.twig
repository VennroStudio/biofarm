<div class="min-w-0 rounded-3xl border border-border bg-[#f3f8f6] p-3 md:p-4" data-product-gallery>
    <button
        class="group relative flex h-[320px] w-full cursor-zoom-in items-center justify-center overflow-hidden rounded-2xl bg-background text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:h-[400px] xl:h-[440px] 2xl:h-[480px]"
        type="button"
        aria-label="Открыть фото товара"
        data-product-gallery-open
    >
        <img
            class="h-full w-full object-contain p-5 md:p-7"
            src="{{ product.imageItems[0].path }}"
            alt="{{ product.imageItems[0].alt }}"
            title="{{ product.imageItems[0].title ?: product.title }}"
            {% if product.imageItems[0].width %}width="{{ product.imageItems[0].width }}"{% endif %}
            {% if product.imageItems[0].height %}height="{{ product.imageItems[0].height }}"{% endif %}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-product-gallery-main
        >
        {% if product.badge %}
            <span class="absolute left-3 top-3 max-w-[75%] rounded-full bg-secondary px-3 py-1.5 text-xs font-medium text-primary md:left-4 md:top-4">{{ product.badge }}</span>
        {% endif %}
        <span class="absolute bottom-3 right-3 flex h-10 w-10 items-center justify-center rounded-full border border-border bg-background/95 text-primary transition-colors group-hover:bg-secondary md:bottom-4 md:right-4">
            <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-5-5M11 8v6M8 11h6"></path></svg>
        </span>
    </button>

    {% if product.imageItems|length > 1 %}
        <div class="mt-3 flex items-center justify-center gap-2 py-1 md:gap-3">
            <button class="inline-flex h-10 w-6 shrink-0 items-center justify-center rounded-lg text-primary transition-colors hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:w-8" type="button" aria-label="Предыдущее фото" data-product-gallery-up>
                <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
            </button>
            <div class="flex min-w-0 items-center justify-center gap-2 px-1 py-1 md:gap-3">
                {% for image in product.imageItems|slice(0, 4) %}
                    <button
                        class="{{ loop.first ? 'border-primary ring-2 ring-primary/20' : 'border-transparent hover:border-muted-foreground/30' }} h-14 w-14 min-w-0 overflow-hidden rounded-xl border-2 bg-background transition-all duration-200 sm:h-16 sm:w-16"
                        type="button"
                        aria-label="Показать фото {{ loop.index }}"
                        data-product-gallery-thumb
                        data-gallery-index="{{ loop.index0 }}"
                    >
                        <img src="{{ image.path }}" alt="{{ image.alt }}" title="{{ image.title ?: product.title }}" {% if image.width %}width="{{ image.width }}"{% endif %} {% if image.height %}height="{{ image.height }}"{% endif %} class="h-full w-full object-contain p-1" loading="{{ loop.first ? 'eager' : 'lazy' }}" decoding="async">
                    </button>
                {% endfor %}
            </div>
            <button class="inline-flex h-10 w-6 shrink-0 items-center justify-center rounded-lg text-primary transition-colors hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:w-8" type="button" aria-label="Следующее фото" data-product-gallery-down>
                <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
        </div>
    {% else %}
        <p class="pb-1 pt-3 text-center text-xs text-muted-foreground">Нажмите на фото, чтобы увеличить</p>
    {% endif %}

    <div
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95"
        role="dialog"
        aria-modal="true"
        aria-label="Галерея товара"
        aria-hidden="true"
        tabindex="-1"
        data-product-gallery-lightbox
    >
        <button
            class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium text-white ring-offset-background transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0"
            type="button"
            aria-label="Закрыть галерею"
            data-product-gallery-close
        >
            <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>

        {% if product.imageItems|length > 1 %}
            <button
                class="absolute left-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium text-white ring-offset-background transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0"
                type="button"
                aria-label="Предыдущее фото"
                data-product-gallery-prev
            >
                <svg class="h-8 w-8" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
            </button>
            <button
                class="absolute right-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium text-white ring-offset-background transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0"
                type="button"
                aria-label="Следующее фото"
                data-product-gallery-next
            >
                <svg class="h-8 w-8" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6"></path>
                </svg>
            </button>
        {% endif %}

        <img
            src="{{ product.imageItems[0].path }}"
            alt="{{ product.imageItems[0].alt }}"
            title="{{ product.imageItems[0].title ?: product.title }}"
            class="max-h-[90vh] max-w-[90vw] object-contain"
            data-product-gallery-lightbox-image
        >

        {% if product.imageItems|length > 1 %}
            <div class="absolute bottom-4 left-1/2 flex max-w-[90vw] -translate-x-1/2 gap-2 overflow-x-auto p-1">
                {% for image in product.imageItems %}
                    <button
                        class="{{ loop.first ? 'border-white opacity-100' : 'border-transparent opacity-60 hover:opacity-100' }} h-16 w-16 shrink-0 overflow-hidden rounded-lg border-2 transition-all"
                        type="button"
                        aria-label="Показать фото {{ loop.index }}"
                        data-product-gallery-lightbox-thumb
                        data-gallery-index="{{ loop.index0 }}"
                    >
                        <img src="{{ image.path }}" alt="{{ image.alt }}" class="h-full w-full object-cover" loading="lazy" decoding="async">
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div
        data-react-island="product-gallery"
        data-root-selector="[data-product-gallery]"
        data-images="{{ product.images|json_encode|e('html_attr') }}"
        data-product-name="{{ product.title }}"
        hidden
    ></div>
</div>

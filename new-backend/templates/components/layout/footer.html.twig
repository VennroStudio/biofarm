{% set commerceLinks = site_feature('cart_enabled') ? [
    { label: 'Доставка', href: '/dostavka' },
    { label: 'Оплата', href: '/oplata' },
    { label: 'Возврат', href: '/vozvrat' },
] : [] %}
{% set infoLinks = commerceLinks | merge([
    { label: 'Публичная оферта', href: '/oferta' },
    { label: 'Политика конфиденциальности', href: '/privacy' },
]) | merge(cms_footer_pages()) %}

<footer class="border-t border-border bg-[#f3f8f6] text-foreground">
    <div class="container mx-auto px-5 py-8 md:px-8 lg:px-12">
        <a href="/" class="mb-6 inline-flex" aria-label="БИОФАРМ"><img src="{{ site.brand.logoUrl }}" alt="{{ site.brand.title }}" class="h-10 w-auto [filter:brightness(0)_saturate(100%)_invert(29%)_sepia(20%)_saturate(1250%)_hue-rotate(122deg)_brightness(89%)_contrast(91%)]" loading="lazy" decoding="async"></a>
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
            <div class="sm:col-span-2 lg:col-span-1">
                <div class="mb-6 flex items-center gap-2">
                    <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M16 6h.01"></path>
                        <path d="M12 6h.01"></path>
                        <path d="M12 10h.01"></path>
                        <path d="M12 14h.01"></path>
                        <path d="M16 10h.01"></path>
                        <path d="M16 14h.01"></path>
                        <path d="M8 10h.01"></path>
                        <path d="M8 14h.01"></path>
                    </svg>
                    <h4 class="text-lg font-medium">Реквизиты организации</h4>
                </div>
                <div class="space-y-3 text-sm">
                    <div>
                        <p class="mb-2 font-semibold text-foreground">Название организации:</p>
                        <p class="leading-relaxed text-muted-foreground">
                            ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ "ИНСТИТУТ ИЗУЧЕНИЯ БИОЛОГИЧЕСКИ АКТИВНЫХ ВЕЩЕСТВ "БИОФАРМ"
                        </p>
                    </div>
                    <div>
                        <p class="mb-2 font-semibold text-foreground">Юридический адрес:</p>
                        <p class="leading-relaxed text-muted-foreground">
                            634045, {{ site_setting('site_address_country', 'РОССИЯ') }},
                            {{ site_setting('site_address_region', 'ТОМСКАЯ ОБЛАСТЬ') }},
                            {{ site_setting('site_address_locality', 'Томск') }},
                            {{ site_setting('site_address_street', 'особая экономическая зона микрорайон Академгородок, проспект Развитие 3Е') }}
                        </p>
                    </div>
                </div>
            </div>

            <div>
                <h4 class="mb-4 font-medium">Реквизиты</h4>
                <div class="space-y-3 text-sm">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="mb-1 font-semibold text-foreground">ИНН:</p>
                            <p class="text-muted-foreground">7017490966</p>
                        </div>
                        <div>
                            <p class="mb-1 font-semibold text-foreground">КПП:</p>
                            <p class="text-muted-foreground">701701001</p>
                        </div>
                        <div class="col-span-2">
                            <p class="mb-1 font-semibold text-foreground">ОГРН:</p>
                            <p class="text-muted-foreground">1227000001557</p>
                        </div>
                    </div>
                    <div>
                        <p class="mb-2 font-semibold text-foreground">Расчетный счет:</p>
                        <p class="text-muted-foreground">40702810610001034144</p>
                    </div>
                </div>
            </div>

            <div>
                <h4 class="mb-4 font-medium">Банк</h4>
                <div class="space-y-3 text-sm">
                    <div>
                        <p class="mb-3 text-muted-foreground">АО «ТБанк»</p>
                        <div class="space-y-2 text-muted-foreground">
                            <p><span class="font-semibold">ИНН банка:</span> 7710140679</p>
                            <p><span class="font-semibold">БИК банка:</span> 044525974</p>
                            <p><span class="font-semibold">Корр. счет:</span> 30101810145250000974</p>
                            <p class="mt-2 text-xs">
                                <span class="font-semibold">Адрес банка:</span> 127287, г. Москва, ул. Хуторская 2-я, д. 38А, стр. 26
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <h4 class="mb-4 font-medium">Информация</h4>
                <ul class="space-y-3">
                    {% for link in infoLinks %}
                        <li>
                            <a
                                href="{{ link.href }}"
                                class="text-sm text-muted-foreground transition-colors hover:text-primary"
                            >
                                {{ link.label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="mt-6 flex flex-col items-center justify-between gap-4 border-t border-border pt-5 md:flex-row">
            <p class="text-sm text-muted-foreground">
                © {{ 'now'|date('Y') }} BioFarm. Все права защищены.
            </p>
        </div>
    </div>
</footer>

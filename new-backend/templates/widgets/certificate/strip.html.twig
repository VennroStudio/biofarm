        <div class="flex flex-col overflow-hidden rounded-xl border border-border bg-card shadow-premium lg:flex-row">
            <a href="/certificates" class="flex shrink-0 items-center gap-4 p-4 text-base lg:w-1/4 lg:p-6 lg:text-lg leading-snug text-secondary-foreground">
                <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2h9l5 5v15H4V2h2Z"/><path d="M14 2v6h6M8 12h8M8 16h8"/></svg>
                Сертификаты<br>и документы <span aria-hidden="true">→</span>
            </a>
            <div class="grid min-w-0 flex-1 {{ certificates|length == 1 ? 'grid-cols-1' : (certificates|length == 2 ? 'grid-cols-2' : 'grid-cols-3') }}">
            {% for certificate in certificates %}
                <a href="{{ certificate.filePath }}" target="_blank" rel="noopener noreferrer" class="group flex min-w-0 flex-col items-center justify-start gap-2 border-l border-t border-border p-2 py-4 text-center hover:bg-secondary sm:p-4 lg:min-h-40 lg:justify-center lg:border-t-0">
                    <span class="flex h-24 w-[72px] flex-col gap-2 border border-[#cbd6d4] bg-white p-2 shadow-sm" aria-hidden="true">
                        <span class="text-[5px] leading-tight text-muted-foreground">{{ certificate.title }}</span>
                        <span class="mt-auto h-px w-full bg-border"></span><span class="h-px w-full bg-border"></span><span class="h-px w-full bg-border"></span><span class="h-px w-3/4 bg-border"></span><span class="h-px w-full bg-border"></span>
                    </span>
                    <span class="break-words text-[10px] font-medium leading-snug sm:text-xs">{{ certificate.title }} ↗</span>
                    {% if certificate.productName|default(null) %}<span class="break-words text-[10px] leading-snug text-muted-foreground sm:text-xs">{{ certificate.productName }}</span>{% endif %}
                    {% if certificate.description %}<span class="hidden text-xs text-muted-foreground lg:block">{{ certificate.description }}</span>{% endif %}
                </a>
            {% else %}
                <p class="col-span-full p-6 text-sm text-muted-foreground">Сертификаты появятся после добавления документов.</p>
            {% endfor %}
            </div>
        </div>

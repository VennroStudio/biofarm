{% extends 'layouts/main.html.twig' %}

{% block title %}{{ page.meta.title }}{% endblock %}
{% block description %}{{ page.meta.description }}{% endblock %}

{% block content %}
    <section class="bg-secondary/30 pb-8 pt-28 md:pb-14 md:pt-32">
        <div class="container mx-auto px-4 text-center">
            <p class="mb-2 text-sm font-semibold text-secondary">FAQ</p>
            <h1 class="font-display text-4xl font-bold text-foreground md:text-5xl">Вопросы и ответы</h1>
            <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
                Собрали ответы на частые вопросы о продукции, заказах и бонусной программе.
            </p>
        </div>
    </section>

    {% include 'sections/faq/list.html.twig' with {
        items: page.items,
        eyebrow: 'FAQ',
        title: 'Частые вопросы',
    } only %}
{% endblock %}

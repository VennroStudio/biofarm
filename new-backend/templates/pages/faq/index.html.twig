{% extends 'layouts/main.html.twig' %}

{% block title %}{{ page.meta.title }}{% endblock %}
{% block description %}{{ page.meta.description }}{% endblock %}

{% block content %}
    <section class="border-b border-border bg-secondary/40 pb-8 pt-28 md:pb-10">
        <div class="container mx-auto px-5 md:px-8 lg:px-12">
            <p class="mb-3 text-xs uppercase tracking-widest text-primary">FAQ</p>
            <h1 class="text-3xl font-normal text-primary md:text-5xl">Вопросы и ответы</h1>
            <p class="mt-4 max-w-2xl text-muted-foreground">
                Собрали ответы на частые вопросы о продукции, заказах и бонусной программе.
            </p>
        </div>
    </section>

    {% include 'sections/faq/list.html.twig' with {
        items: page.items,
        eyebrow: 'FAQ',
        title: 'Частые вопросы',
    } only %}
{% endblock %}

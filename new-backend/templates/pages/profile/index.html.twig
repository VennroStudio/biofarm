{% extends 'layouts/main.html.twig' %}

{% block content %}
    <div
        data-react-island="profile-page"
        data-cart-enabled="{{ site_feature('cart_enabled') ? 'true' : 'false' }}"
        data-favorites-enabled="{{ site_feature('favorites_enabled') ? 'true' : 'false' }}"
        data-referral-enabled="{{ site_feature('referral_enabled') ? 'true' : 'false' }}"
        data-withdrawals-enabled="{{ site_feature('withdrawals_enabled') ? 'true' : 'false' }}"
    >
        <section class="container mx-auto px-4 pb-12 pt-[128px] sm:px-6">
            <h1 class="text-4xl font-normal tracking-tight text-primary">Личный кабинет</h1>
            <p class="mt-3 max-w-2xl text-base text-muted-foreground">
                История заказов, бонусы и партнерские данные доступны после входа.
            </p>
        </section>
    </div>
{% endblock %}

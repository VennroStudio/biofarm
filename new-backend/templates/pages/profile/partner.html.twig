     data-withdrawals-enabled="{{ site_feature('withdrawals_enabled') ? 'true' : 'false' }}">
    <section class="container mx-auto px-4 pb-12 pt-[128px] sm:px-6">
        <h1 class="text-4xl font-normal text-primary">Партнёрская программа</h1>
        <p class="mt-3 text-muted-foreground">Войдите, чтобы увидеть свою команду, продажи и выплаты.</p>

{% extends 'layouts/main.html.twig' %}

{% block content %}
    <section class="bg-secondary/30 px-5 pb-10 pt-28 md:px-8 lg:px-12">
        <div class="container mx-auto grid gap-8 rounded-2xl border border-border bg-card p-6 md:grid-cols-[1.05fr_0.95fr] md:items-center md:p-8">
            <div>
                <p class="mb-4 text-sm font-semibold text-secondary">{{ page.page.title }}</p>
                <h1 class="text-3xl font-normal leading-tight text-primary md:text-5xl">
                    {{ page.page.h1|default(page.page.title) }}
                </h1>
                {% if page.page.excerpt %}
                    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{{ page.page.excerpt }}</p>
                {% endif %}
            </div>
            {% if page.page.ogImage %}
                <img class="aspect-[4/3] w-full rounded-2xl object-cover" src="{{ page.page.ogImage }}" alt="{{ page.page.ogImageAlt|default(page.page.title) }}">
            {% endif %}
        </div>
    </section>

    {% include 'sections/content/rich-text.html.twig' with { content: page.page.content|default(null) } only %}
{% endblock %}

{% extends 'layouts/main.html.twig' %}

{% block title %}{{ page.meta.title }}{% endblock %}

{% block description %}{{ page.meta.description }}{% endblock %}

{% block content %}
    {% if page.product %}
        {% include 'sections/product/detail.html.twig' with {
            product: page.product,
        } only %}
        {% include 'sections/product/certificates.html.twig' with {
            certificates: page.certificates,
        } only %}
        {% include 'sections/product/related-posts.html.twig' with {
            posts: page.relatedPosts,
        } only %}
        {% include 'sections/faq/list.html.twig' with {
            items: page.faqItems,
            eyebrow: 'FAQ',
            title: 'Вопросы о товаре',
        } only %}
        {% include 'sections/product/related.html.twig' with {
            products: page.relatedProducts,
        } only %}
    {% else %}
        <div class="container mx-auto px-5 py-32 text-center md:px-8 lg:px-12">
            <h1 class="mb-4 text-3xl font-normal text-primary">
                Товар не найден
            </h1>
            <p class="mb-8 text-muted-foreground">
                К сожалению, такого товара не существует
            </p>
            <a
                href="/catalog"
                class="gradient-primary inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-md px-4 py-2 text-sm font-medium text-primary-foreground ring-offset-background transition-opacity hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
                Вернуться в каталог
            </a>
        </div>
    {% endif %}
{% endblock %}

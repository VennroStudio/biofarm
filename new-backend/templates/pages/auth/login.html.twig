        data-registration-enabled="{{ site_feature('registration_enabled') ? 'true' : 'false' }}"
    >
        <section class="container mx-auto max-w-7xl px-4 pb-12 pt-[128px] sm:px-6">
            <h1 class="text-4xl font-normal tracking-tight text-primary">Личный кабинет</h1>

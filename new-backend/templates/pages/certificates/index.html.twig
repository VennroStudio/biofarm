{% extends 'layouts/main.html.twig' %}

{% block title %}{{ page.meta.title }}{% endblock %}

{% block description %}{{ page.meta.description }}{% endblock %}

{% block content %}
    <section class="bg-background pb-12 pt-28 md:pb-16">
        <div class="container mx-auto px-5 md:px-8 lg:px-12">
            <div class="mb-8 rounded-2xl border border-border bg-secondary/40 p-6 md:p-8">
                <p class="mb-3 text-xs uppercase tracking-widest text-primary">Документы</p>
                <h1 class="mb-4 text-3xl font-normal text-primary md:text-5xl">Сертификаты качества</h1>
                <p class="text-lg text-muted-foreground">
                    Документы на продукцию БИОФАРМ: сертификаты, декларации и подтверждения качества.
                </p>
            </div>

            {% include 'sections/certificates/list.html.twig' with {
                certificates: page.certificates,
            } only %}
        </div>
    </section>

    {% include 'sections/faq/list.html.twig' with {
        items: page.faqItems,
        eyebrow: 'FAQ',
        title: 'Вопросы о сертификатах',
    } only %}
{% endblock %}

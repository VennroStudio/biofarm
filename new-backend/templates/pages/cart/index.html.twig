{% extends 'layouts/main.html.twig' %}

{% block content %}
    <div
        data-react-island="cart-page"
        data-cdek-delivery-price="{{ site_setting('cdek_delivery_price', 350) }}"
        data-free-delivery-threshold="{{ site_setting('free_delivery_threshold', 3000) }}"
        data-order-bonus-enabled="{{ site_feature('order_bonus_enabled') ? 'true' : 'false' }}"
        data-order-bonus-percent="{{ site_setting('order_bonus_percent', 5) }}"
    >
        <section class="container mx-auto max-w-7xl px-4 py-12 sm:px-6">
            <h1 class="text-4xl font-normal tracking-tight text-primary">Корзина</h1>
            <p class="mt-3 max-w-2xl text-base text-muted-foreground">
                Проверьте выбранные товары БИОФАРМ перед оформлением заказа.
            </p>
        </section>
    </div>
{% endblock %}

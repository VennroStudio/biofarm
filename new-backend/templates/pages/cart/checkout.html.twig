{% extends 'layouts/main.html.twig' %}

{% block content %}
    <div
        data-react-island="checkout-page"
        data-cdek-delivery-price="{{ site_setting('cdek_delivery_price', 350) }}"
        data-free-delivery-threshold="{{ site_setting('free_delivery_threshold', 3000) }}"
        data-order-bonus-enabled="{{ site_feature('order_bonus_enabled') ? 'true' : 'false' }}"
        data-order-bonus-percent="{{ site_setting('order_bonus_percent', 5) }}"
        data-order-bonus-spend-limit-percent="{{ site_setting('order_bonus_spend_limit_percent', 30) }}"
        data-post-delivery-price="{{ site_setting('post_delivery_price', 250) }}"
        data-promo-codes-enabled="{{ site_feature('promo_codes_enabled') ? 'true' : 'false' }}"
    >
        <section class="container mx-auto max-w-7xl px-4 pb-12 pt-[128px] sm:px-6">
            <h1 class="text-4xl font-normal tracking-tight text-primary">Оформление заказа</h1>
            <p class="mt-3 max-w-2xl text-base text-muted-foreground">
                Укажите контактные данные и способ доставки для заказа продукции БИОФАРМ.
            </p>
        </section>
    </div>
{% endblock %}

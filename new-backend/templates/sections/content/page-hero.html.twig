{% set cms = page.page %}
{% set title = cms.h1|default(cms.title) %}
{% set lead = cms.excerpt|default(page.meta.description) %}

<section class="border-b border-border bg-secondary/40 px-5 pb-8 pt-28 md:px-8 md:pb-10 lg:px-12">
    <div class="container mx-auto">
        <a class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition hover:text-primary" href="/">
            <span aria-hidden="true">←</span>
            На главную
        </a>
        <h1 class="text-3xl font-normal leading-tight text-primary md:text-5xl">{{ title }}</h1>
        {% if lead %}
            <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">{{ lead }}</p>
        {% endif %}
    </div>
</section>

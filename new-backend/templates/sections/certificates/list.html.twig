{% if certificates is not empty %}
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {% for certificate in certificates %}
            <a
                class="group rounded-2xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
                href="{{ certificate.filePath }}"
                target="_blank"
                rel="noopener noreferrer"
            >
                <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                        <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                        <path d="M10 9H8"></path>
                        <path d="M16 13H8"></path>
                        <path d="M16 17H8"></path>
                    </svg>
                </div>
                <h2 class="mb-2 text-lg font-medium text-foreground transition-colors group-hover:text-primary">{{ certificate.title }}</h2>
                {% if certificate.productName %}
                    <p class="mb-3 text-sm font-semibold text-primary">{{ certificate.productName }}</p>
                {% endif %}
                {% if certificate.description %}
                    <p class="mb-5 line-clamp-3 text-sm leading-6 text-muted-foreground">{{ certificate.description }}</p>
                {% endif %}
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary">
                    Открыть документ
                    <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h6v6"></path>
                        <path d="M10 14 21 3"></path>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    </svg>
                </span>
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="rounded-2xl border border-dashed border-border bg-card p-8 text-center text-muted-foreground">
        Сертификаты появятся после добавления документов.
    </div>
{% endif %}

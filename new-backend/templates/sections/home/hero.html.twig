{% set slides = [
    { key: 'intro', title: 'Растительные экстракты и капсулы БИОФАРМ', alt: 'Ассортимент капсул БИОФАРМ' },
    { key: 'care', title: 'Забота о себе начинается с малого.', alt: 'Исландский мох и Ресвератрол' },
    { key: 'health', title: 'Твоё здоровье в твоих руках.', alt: 'Антистресс и Берберин + хром' },
    { key: 'nature', title: 'Природа в основе. Забота каждый день.', alt: 'Экстракт чаги и Родиола розовая' },
    { key: 'daily', title: 'Время для себя. Каждый день.', alt: 'Кардиобит и Гастролайт' }
] %}
<section class="home-hero" data-home-hero role="region" aria-roledescription="карусель" aria-label="БИОФАРМ — растительные экстракты и капсулы">
    <h1 class="sr-only">Растительные экстракты и капсулы БИОФАРМ</h1>
    <div class="home-hero__stage" data-hero-stage>
        {% for slide in slides %}
            <div id="hero-slide-{{ loop.index }}" class="home-hero__slide home-hero__slide--{{ slide.key }}" data-hero-slide role="group" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ slides|length }}: {{ slide.alt }}" {% if not loop.first %}hidden inert{% endif %}>
                {# Crop only the surrounding artwork in CSS. Original bottles/labels are never regenerated. #}
                <div class="home-hero__art" aria-hidden="true">
                    <img src="/assets/images/home/slider/{{ slide.key }}-original.jpg" width="853" height="1280" alt="" loading="{{ loop.first ? 'eager' : 'lazy' }}" decoding="async" {% if loop.first %}fetchpriority="high"{% endif %}>
                </div>
                {% if loop.first %}
                    <div class="home-hero__video-content">
                        <video class="home-hero__video" data-hero-video controls playsinline muted preload="metadata" poster="/assets/images/home/slider/rhodiola-poster.jpg" aria-label="Видео о родиоле розовой БИОФАРМ">
                            <source src="/assets/videos/home/rhodiola.mp4" type="video/mp4">
                            <a href="/assets/videos/home/rhodiola.mp4">Смотреть видео о родиоле розовой</a>
                        </video>
                        <a class="home-hero__cta" href="/catalog">Смотреть каталог <span aria-hidden="true">→</span></a>
                    </div>
                {% else %}
                    <div class="home-hero__copy">
                        <h2>{{ slide.title }}</h2>
                        <p>Растительные экстракты и капсулы</p>
                        <a class="home-hero__cta" href="/catalog">Смотреть каталог <span aria-hidden="true">→</span></a>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <div class="home-hero__navigation" data-hero-navigation hidden>
        <button class="home-hero__arrow" type="button" data-hero-prev aria-label="Предыдущий слайд">←</button>
        <div class="home-hero__dots" aria-label="Выбрать слайд">
            {% for slide in slides %}
                <button class="home-hero__dot" type="button" data-hero-go="{{ loop.index0 }}" aria-label="Слайд {{ loop.index }}: {{ slide.alt }}" aria-controls="hero-slide-{{ loop.index }}" {% if loop.first %}aria-current="true"{% endif %}><span></span></button>
            {% endfor %}
        </div>
        <button class="home-hero__arrow" type="button" data-hero-next aria-label="Следующий слайд">→</button>
    </div>
    <p class="sr-only" data-hero-status aria-live="polite" aria-atomic="true"></p>
</section>

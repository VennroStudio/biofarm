<section id="video" class="relative overflow-hidden bg-secondary bg-[url('/assets/images/design/production.webp')] bg-cover bg-center" data-home-video-root>
    <div id="production" class="container mx-auto px-5 py-8 md:px-8 lg:px-12">
        <div class="max-w-2xl rounded-xl bg-secondary/90 p-4 md:bg-transparent md:p-0 lg:py-3">
            <h2 class="mb-4 text-4xl font-normal leading-none text-primary md:text-[48px]">От сырья<br>до готового продукта</h2>
            <p class="max-w-xl text-base leading-relaxed text-secondary-foreground">Мы контролируем каждый этап — от отбора и входного контроля сырья до производства, фасовки и выпуска партии. Собственная лаборатория проверяет качество и безопасность по установленным показателям, а каждая партия проходит документированную проверку.</p>
            <ul class="my-5 flex max-w-xl flex-wrap gap-x-5 gap-y-2 text-xs text-secondary-foreground">
                <li>Собственная лаборатория контроля качества</li><li>Полный цикл производства</li><li>Сертификация и документация на партии</li><li>Гибкие условия сотрудничества</li>
            </ul>
            <button class="inline-flex min-h-11 items-center gap-3 rounded-lg bg-white px-5 text-sm text-secondary-foreground shadow-premium" type="button" data-home-video-open><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg>Смотреть видео</button>
        </div>
    </div>
    <div
        data-react-island="home-video"
        data-root-selector="[data-home-video-root]"
        data-modal-selector="[data-modal='home-production-video']"
        hidden
    ></div>

    {% embed 'components/ui/modal.html.twig' with {
        id: 'home-production-video',
        eyebrow: 'Наше производство',
        title: 'От сырья до готового продукта',
    } only %}
        {% block body %}
            <div class="aspect-video overflow-hidden rounded-lg bg-black">
                <iframe
                    class="h-full w-full"
                    title="О производстве БИОФАРМ"
                    data-home-video-frame
                    data-src="https://www.youtube.com/embed/O6zCel2mbfM?autoplay=1"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                ></iframe>
            </div>
        {% endblock %}
    {% endembed %}
</section>

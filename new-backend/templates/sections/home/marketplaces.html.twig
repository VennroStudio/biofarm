{% set marketplaces = [
    { name: 'Wildberries', logo: 'WB', tone: 'bg-[#f6eefb]', brand: 'bg-[#b5069f]', url: 'https://www.wildberries.ru/seller/1009387' },
    { name: 'Ozon', logo: 'Ozon', tone: 'bg-[#edf6ff]', brand: 'bg-[#0060ff]', url: 'https://www.ozon.ru/seller/institut-izucheniya-biologicheski-aktivnyh-veshchestv-biofarm-647407/' },
] %}
<section id="marketplaces" class="py-8 md:py-10">
    <div class="container mx-auto px-5 md:px-8 lg:px-12">
        <h2 class="mb-5 text-3xl font-normal text-primary md:text-[42px]">БИОФАРМ на маркетплейсах</h2>
        <div class="grid gap-5 md:grid-cols-2">
            {% for marketplace in marketplaces %}
                <article class="relative isolate min-h-[265px] overflow-hidden rounded-2xl p-6 {{ marketplace.tone }}">
                    <div class="flex items-center gap-4"><span class="flex h-12 w-12 items-center justify-center rounded-xl text-xl font-semibold text-white {{ marketplace.brand }}">{{ marketplace.logo }}</span><div><h3 class="text-2xl font-normal">{{ marketplace.name }}</h3><p class="text-xs text-muted-foreground">Официальный магазин</p></div></div>
                    <p class="relative z-10 mb-16 mt-4 max-w-[60%] text-sm leading-relaxed text-muted-foreground">Каталог продукции БИОФАРМ и оформление заказа на {{ marketplace.name }}.</p>
                    <img src="/assets/images/design/parcel.webp" alt="" class="absolute bottom-14 right-0 -z-10 h-40 w-[43%] object-contain" loading="lazy" decoding="async">
                    <a href="{{ marketplace.url }}" target="_blank" rel="noopener noreferrer" class="absolute inset-x-6 bottom-5 inline-flex min-h-11 items-center justify-between gap-3 rounded-lg px-4 py-2 text-xs text-white sm:right-auto {{ marketplace.brand }}">Перейти на {{ marketplace.name }} <span aria-hidden="true">↗</span></a>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

                href="/certificates"
                data-reveal
            >
                Все сертификаты
                <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <div data-reveal>
            {% include 'sections/certificates/list.html.twig' with { certificates: certificates } only %}
        </div>
    </div>
</section>

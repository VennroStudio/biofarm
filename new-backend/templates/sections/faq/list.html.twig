{% if items is not empty %}
    <section class="bg-background py-16">
        <div class="container mx-auto px-4">
            <div class="mx-auto mb-10 max-w-2xl text-center">
                <p class="mb-2 text-sm font-semibold text-secondary">{{ eyebrow|default('FAQ') }}</p>
                <h2 class="font-display text-3xl font-bold text-foreground">{{ title|default('Ответы на вопросы') }}</h2>
            </div>
            <div class="mx-auto grid max-w-4xl gap-4">
                {% for item in items %}
                    <details class="group rounded-2xl bg-card p-5 shadow-premium open:shadow-premium-lg">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-foreground">
                            <span>{{ item.question }}</span>
                            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform group-open:rotate-45">
                                <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14"></path>
                                    <path d="M12 5v14"></path>
                                </svg>
                            </span>
                        </summary>
                        <div class="mt-4 text-sm leading-7 text-muted-foreground">
                            {{ item.answer|raw }}
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}

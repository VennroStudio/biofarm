{% if certificates is not empty %}
    <section class="bg-background py-12">
        <div class="container mx-auto px-4">
            <div class="mb-8">
                <p class="mb-2 text-sm font-semibold text-secondary">Документы</p>
                <h2 class="font-display text-2xl font-bold text-foreground">Сертификаты и документы</h2>
            </div>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {% for certificate in certificates %}
                    <a
                        class="group rounded-2xl bg-card p-5 shadow-premium transition-all duration-300 hover:shadow-premium-lg"
                        href="{{ certificate.filePath }}"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                <path d="M10 9H8"></path>
                                <path d="M16 13H8"></path>
                                <path d="M16 17H8"></path>
                            </svg>
                        </div>
                        <h3 class="mb-2 font-bold text-foreground transition-colors group-hover:text-primary">{{ certificate.title }}</h3>
                        {% if certificate.description %}
                            <p class="mb-4 line-clamp-2 text-sm text-muted-foreground">{{ certificate.description }}</p>
                        {% endif %}
                        <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary">
                            Открыть документ
                            <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h6v6"></path>
                                <path d="M10 14 21 3"></path>
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            </svg>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}

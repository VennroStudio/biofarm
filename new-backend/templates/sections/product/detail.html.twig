{% set hasProductDetails = product.ingredients or product.activeComponentsText or product.usageText or product.contraindications or product.country or product.shelfLife or product.storageConditions or product.badDisclaimer %}
<div class="pt-24 md:pt-28">
    <div class="container mx-auto px-5 md:px-8 lg:px-12">
        <nav class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground md:text-sm" aria-label="Хлебные крошки">
            <a class="transition-colors hover:text-primary" href="/">Главная</a>
            <span aria-hidden="true">/</span>
            <a class="transition-colors hover:text-primary" href="/catalog">Каталог</a>
            <span aria-hidden="true">/</span>
            <span class="text-foreground" aria-current="page">{{ product.title }}</span>
        </nav>
    </div>
</div>

<section class="pb-8 pt-6 md:pb-10 md:pt-8" data-product-detail-root>
    <span hidden data-react-island="product-detail" data-root-selector="[data-product-detail-root]"></span>
    <div class="container mx-auto px-5 md:px-8 lg:px-12">
        <div class="grid items-start gap-7 md:grid-cols-2 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)_minmax(300px,0.8fr)] xl:gap-8 2xl:gap-10">
            <div class="min-w-0">
                {% include 'components/product/gallery.html.twig' with { product: product } only %}
            </div>

            <div class="min-w-0 py-1 md:py-3">
                {% if product.category %}
                    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-primary">{{ product.category }}</p>
                {% endif %}
                <h1 class="break-words text-3xl font-normal leading-tight text-foreground md:text-4xl 2xl:text-5xl">{{ product.h1 ?: product.title }}</h1>
                {% if product.weight or product.sku %}
                    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
                        {% if product.weight %}<span class="rounded-full bg-secondary px-3 py-1.5 font-medium text-primary">{{ product.weight }}</span>{% endif %}
                        {% if product.sku %}<span class="text-muted-foreground">Артикул: {{ product.sku }}</span>{% endif %}
                    </div>
                {% endif %}
                {% if product.shortDescription %}
                    <p class="mt-5 text-base leading-relaxed text-muted-foreground 2xl:text-lg">{{ product.shortDescription }}</p>
                {% endif %}

                {% if product.variants is not empty %}
                    <div class="mt-7 border-t border-border pt-6">
                        <h2 class="mb-3 text-sm font-semibold text-foreground">Вариант продукта</h2>
                        <div class="flex flex-wrap gap-2.5">
                            {% for variant in product.variants %}
                                <a href="/product/{{ variant.slug }}" class="group inline-flex min-w-28 max-w-full items-center gap-3 rounded-xl border bg-background p-2.5 pr-4 transition-colors hover:border-primary/60 {{ variant.isCurrent ? 'border-primary ring-2 ring-primary/15' : 'border-border' }}" aria-current="{{ variant.isCurrent ? 'page' : 'false' }}">
                                    <img class="h-12 w-12 shrink-0 rounded-lg object-contain" src="{{ variant.image }}" alt="{{ variant.imageAlt ?: variant.title }}" loading="lazy" decoding="async">
                                    <span class="text-sm font-medium leading-snug text-foreground group-hover:text-primary">{{ variant.label }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if product.features is not empty %}
                    <div class="mt-7 border-t border-border pt-6">
                        <h2 class="mb-3 text-sm font-semibold text-foreground">Особенности продукта</h2>
                        <ul class="space-y-3">
                            {% for feature in product.features %}
                                <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                                    <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-secondary text-primary">
                                        <svg class="h-3 w-3" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"></path></svg>
                                    </span>
                                    {{ feature }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                <a class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary" data-product-description-link href="#product-description">Подробнее о продукте <span aria-hidden="true">↓</span></a>
            </div>

            <aside class="min-w-0 rounded-3xl border border-border bg-[#f3f8f6] p-5 md:col-span-2 md:p-7 xl:col-span-1" aria-label="Покупка продукта">
                <p class="mb-3 text-sm text-muted-foreground">Цена продукта</p>
                <div class="flex flex-wrap items-end gap-x-3 gap-y-2">
                    <span class="text-4xl font-medium tracking-tight text-foreground">{{ product.price|money }}</span>
                    {% if product.oldPrice %}
                        <span class="pb-1 text-base text-muted-foreground line-through">{{ product.oldPrice|money }}</span>
                        <span class="mb-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">−{{ ((1 - product.price / product.oldPrice) * 100)|round }}%</span>
                    {% endif %}
                </div>
                {% if product.weight %}<p class="mt-2 text-sm text-muted-foreground">{{ product.weight }}</p>{% endif %}

                {% if site_feature('cart_enabled') %}
                    <div class="mt-6" data-product-cart data-product="{{ { id: product.id, slug: product.slug, title: product.title, image: product.image, price: product.price, weight: product.weight }|json_encode|e('html_attr') }}">
                        <div class="mb-4 flex items-center justify-between gap-4">
                            <span class="text-sm text-muted-foreground">Количество</span>
                            <div class="flex items-center rounded-xl border border-border bg-background p-1">
                                <button class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-foreground transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="button" data-cart-decrement aria-label="Уменьшить количество">
                                    <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"></path></svg>
                                </button>
                                <span class="w-10 text-center text-sm font-semibold" data-cart-quantity aria-live="polite">1</span>
                                <button class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-foreground transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="button" data-cart-increment aria-label="Увеличить количество">
                                    <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"></path></svg>
                                </button>
                            </div>
                        </div>
                        <button class="inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-xl bg-primary px-3 py-3 text-sm font-medium leading-snug text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" type="button" data-cart-add>
                            <svg class="h-5 w-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
                            <span data-cart-add-label>Добавить в корзину — {{ product.price|money }}</span>
                        </button>
                    </div>
                {% endif %}

                {% if site_feature('favorites_enabled') %}
                    <div class="mt-3">
                        {% include 'components/product/favorite-button.html.twig' with { productId: product.id, compact: false } only %}
                    </div>
                {% endif %}

                {% if site_feature('cart_enabled') %}
                    <div class="mt-5 grid grid-cols-3 gap-2 border-t border-border pt-5 text-center text-xs font-medium text-muted-foreground">
                        <a href="/dostavka" class="rounded-lg py-2 transition-colors hover:bg-background hover:text-primary">Доставка ↗</a>
                        <a href="/oplata" class="rounded-lg py-2 transition-colors hover:bg-background hover:text-primary">Оплата ↗</a>
                        <a href="/vozvrat" class="rounded-lg py-2 transition-colors hover:bg-background hover:text-primary">Возврат ↗</a>
                    </div>
                {% endif %}

                {% if product.wbLink or product.ozonLink %}
                    <div class="mt-5 border-t border-border pt-5">
                        <p class="mb-3 text-xs text-muted-foreground">Также на маркетплейсах</p>
                        <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2">
                            {% if product.wbLink %}<a href="{{ product.wbLink }}" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-between gap-2 rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium text-purple-700 transition-colors hover:border-purple-300">Wildberries <span aria-hidden="true">↗</span></a>{% endif %}
                            {% if product.ozonLink %}<a href="{{ product.ozonLink }}" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-between gap-2 rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium text-blue-700 transition-colors hover:border-blue-300">Ozon <span aria-hidden="true">↗</span></a>{% endif %}
                        </div>
                    </div>
                {% endif %}
            </aside>
        </div>

        <div class="mt-10 grid items-start gap-6 border-t border-border pt-6 md:mt-12 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10" data-product-tabs-root>
            <div class="flex gap-2 [&[hidden]]:hidden lg:sticky lg:top-28 lg:flex-col" role="tablist" aria-label="Информация о продукте" data-product-tablist hidden>
                <button id="product-description-tab" type="button" role="tab" aria-controls="product-description" aria-selected="true" tabindex="0" data-product-tab class="min-h-12 flex-1 rounded-xl px-4 py-3 text-sm font-medium leading-snug text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring aria-selected:bg-secondary aria-selected:text-primary lg:flex-none lg:text-left">О продукте</button>
                {% if hasProductDetails %}<button id="product-information-tab" type="button" role="tab" aria-controls="product-information" aria-selected="false" tabindex="-1" data-product-tab class="min-h-12 flex-1 rounded-xl px-4 py-3 text-sm font-medium leading-snug text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring aria-selected:bg-secondary aria-selected:text-primary lg:flex-none lg:text-left">Состав и применение</button>{% endif %}
            </div>
            <div class="min-w-0 space-y-6">
                <section id="product-description" data-product-panel class="scroll-mt-28 [&[hidden]]:hidden rounded-3xl border border-border bg-background p-6 md:p-9">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary">Знакомство с продуктом</p>
                    <h2 class="mb-6 text-2xl font-normal text-foreground md:text-3xl">Описание</h2>
                    <div class="text-base leading-relaxed text-muted-foreground [&_a]:text-primary [&_a:hover]:underline [&_h2]:mb-4 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:text-foreground [&_h3]:mb-3 [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-medium [&_h3]:text-foreground [&_li]:my-2 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mb-5 [&_p]:leading-relaxed [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-5 [&_img]:max-w-full [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto">
                        {{ product.descriptionHtml|raw }}
                    </div>
                </section>

                {% if hasProductDetails %}
                    <section id="product-information" data-product-panel class="scroll-mt-28 [&[hidden]]:hidden rounded-3xl bg-[#f3f8f6] p-6 md:p-9">
                        <h2 class="mb-7 text-2xl font-normal text-foreground md:text-3xl">Состав и применение</h2>
                        <dl class="grid gap-x-8 gap-y-6 md:grid-cols-2">
                            {% if product.ingredients %}
                                <div class="border-t border-border pt-5"><dt class="mb-2 text-sm font-semibold text-foreground">Состав</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.ingredients|e|nl2br }}</dd></div>
                            {% endif %}
                            {% if product.activeComponentsText %}
                                <div class="border-t border-border pt-5"><dt class="mb-2 text-sm font-semibold text-foreground">Активные компоненты</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.activeComponentsText|e|nl2br }}</dd></div>
                            {% endif %}
                            {% if product.usageText %}
                                <div class="border-t border-border pt-5"><dt class="mb-2 text-sm font-semibold text-foreground">Способ применения</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.usageText|e|nl2br }}</dd></div>
                            {% endif %}
                            {% if product.contraindications %}
                                <div class="border-t border-border pt-5"><dt class="mb-2 text-sm font-semibold text-foreground">Противопоказания</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.contraindications|e|nl2br }}</dd></div>
                            {% endif %}
                            {% if product.country or product.shelfLife or product.storageConditions %}
                                <div class="grid gap-5 border-t border-border pt-5 sm:grid-cols-3 md:col-span-2">
                                    {% if product.country %}<div><dt class="mb-2 text-sm font-semibold text-foreground">Страна</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.country }}</dd></div>{% endif %}
                                    {% if product.shelfLife %}<div><dt class="mb-2 text-sm font-semibold text-foreground">Срок годности</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.shelfLife }}</dd></div>{% endif %}
                                    {% if product.storageConditions %}<div><dt class="mb-2 text-sm font-semibold text-foreground">Условия хранения</dt><dd class="text-sm leading-relaxed text-muted-foreground">{{ product.storageConditions }}</dd></div>{% endif %}
                                </div>
                            {% endif %}
                        </dl>
                        {% if product.badDisclaimer %}<div class="mt-7 rounded-xl border border-primary/15 bg-background px-4 py-4 text-xs leading-relaxed text-muted-foreground">{{ product.badDisclaimer|e|nl2br }}</div>{% endif %}
                    </section>
                {% endif %}
            </div>
        </div>
    </div>
</section>

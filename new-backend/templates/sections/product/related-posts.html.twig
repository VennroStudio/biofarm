{% if posts is not empty %}
    <section class="bg-muted/30 py-16">
        <div class="container mx-auto px-4">
            <div class="mb-8">
                <p class="mb-2 text-sm font-semibold text-secondary">Полезное</p>
                <h2 class="font-display text-2xl font-bold text-foreground">Статьи по теме</h2>
            </div>
            <div class="grid gap-6 md:grid-cols-3">
                {% for post in posts %}
                    {% include 'components/blog/related-card.html.twig' with { post: post } only %}
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}

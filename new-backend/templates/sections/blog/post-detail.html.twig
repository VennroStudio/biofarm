<article class="pb-16 pt-28 md:pb-24 md:pt-32">
    <div class="container mx-auto px-5 md:px-8 lg:px-12">
        <a href="/blog" class="mb-6 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-primary">
            <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5"/></svg>
            Назад в блог
        </a>

        <header class="grid overflow-hidden rounded-3xl bg-secondary/60 lg:grid-cols-2">
            <div class="flex flex-col items-start justify-center p-6 md:p-10 xl:p-14">
                <span class="mb-7 inline-flex rounded-full border border-primary/20 bg-white/60 px-4 py-2 text-xs uppercase tracking-widest text-primary">{{ post.category }}</span>
                <h1 class="text-3xl font-normal leading-[1.12] tracking-tight text-foreground md:text-4xl xl:text-5xl 2xl:text-6xl">{{ post.h1 ?: post.title }}</h1>
                {% if post.excerpt %}
                    <p class="mt-6 text-base leading-relaxed text-muted-foreground md:text-lg">{{ post.excerpt }}</p>
                {% endif %}
                <div class="mt-8 flex w-full flex-wrap items-center gap-x-4 gap-y-2 border-t border-primary/15 pt-6 text-sm text-muted-foreground">
                    <span>{{ post.date }}</span>
                    <span class="h-1 w-1 rounded-full bg-primary/40" aria-hidden="true"></span>
                    <span class="inline-flex items-center gap-2">
                        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        {{ post.readTime }} мин чтения
                    </span>
                </div>
            </div>
            <div class="relative min-h-72 overflow-hidden md:min-h-96 lg:min-h-[560px]">
                {{ optimized_image(post.image, post.imageAlt ?: post.title, {
                    class: 'absolute inset-0 h-full w-full object-cover',
                    loading: 'eager',
                    fetchpriority: 'high',
                    decoding: 'async'
                }) }}
            </div>
        </header>

        <div class="mt-8 grid items-start gap-6 lg:mt-12 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[280px_minmax(0,1fr)] xl:gap-14">
            <aside class="rounded-3xl border border-border bg-card p-6 lg:sticky lg:top-28">
                <p class="mb-5 text-xs uppercase tracking-widest text-muted-foreground">Автор статьи</p>
                <div class="flex items-center gap-3">
                    {% if post.authorAvatar %}
                        {{ optimized_image(post.authorAvatar, post.authorName, {
                            class: 'h-12 w-12 rounded-full object-cover',
                            loading: 'lazy',
                            decoding: 'async'
                        }) }}
                    {% endif %}
                    <p class="text-xl font-normal leading-snug text-foreground">{{ post.authorName }}</p>
                </div>
                <nav aria-label="Навигация по статье" class="mt-6 flex flex-wrap gap-x-5 gap-y-3 border-t border-border pt-5 text-sm lg:flex-col lg:items-start">
                    <a href="#article-text" class="text-primary underline-offset-4 hover:underline">Читать статью</a>
                    {% if relatedPosts is not empty %}
                        <a href="#related-posts" class="text-muted-foreground transition-colors hover:text-primary">Похожие материалы</a>
                    {% endif %}
                    <a href="/blog" class="text-muted-foreground transition-colors hover:text-primary">Все статьи</a>
                </nav>
            </aside>

            <div id="article-text" class="min-w-0 scroll-mt-28 rounded-3xl border border-border bg-card p-6 md:p-10 xl:p-12">
                <div class="max-w-none break-words text-base leading-[1.8] text-foreground md:text-lg [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:my-8 [&_blockquote]:rounded-2xl [&_blockquote]:border-l-2 [&_blockquote]:border-primary [&_blockquote]:bg-secondary/60 [&_blockquote]:p-6 [&_h2]:mb-5 [&_h2]:mt-10 [&_h2]:text-2xl md:[&_h2]:text-3xl [&_h2]:font-normal [&_h2]:leading-tight [&_h2]:tracking-tight [&_h2]:text-foreground [&_h3]:mb-4 [&_h3]:mt-8 [&_h3]:text-2xl [&_h3]:font-normal [&_h3]:leading-snug [&_h3]:text-foreground [&_img]:my-8 [&_img]:h-auto [&_img]:max-w-full [&_img]:rounded-2xl [&_li]:my-2 [&_ol]:my-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-6 [&_strong]:font-medium [&_table]:my-8 [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto [&_td]:border [&_td]:border-border [&_td]:p-3 [&_th]:border [&_th]:border-border [&_th]:bg-secondary [&_th]:p-3 [&_ul]:my-6 [&_ul]:list-disc [&_ul]:pl-6 [&>:first-child]:mt-0 [&>:last-child]:mb-0">
                    {{ post.content|raw }}
                </div>
                <div class="mt-10 flex items-center justify-between gap-4 border-t border-border pt-6">
                    <span class="text-xs uppercase tracking-widest text-primary">{{ post.category }}</span>
                    <a href="/blog" class="inline-flex items-center gap-2 text-sm text-primary">
                        В блог
                        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
        </div>

        {% if relatedPosts is not empty %}
            <section id="related-posts" aria-labelledby="related-posts-title" class="mt-16 scroll-mt-28 border-t border-border pt-10 md:mt-20">
                <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="mb-3 text-xs uppercase tracking-widest text-primary">Продолжить чтение</p>
                        <h2 id="related-posts-title" class="text-3xl font-normal tracking-tight text-foreground md:text-4xl">Похожие статьи</h2>
                    </div>
                    <a href="/blog" class="text-sm text-primary underline underline-offset-4">Все статьи</a>
                </div>
                <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                    {% for relatedPost in relatedPosts %}
                        {% include 'components/blog/related-card.html.twig' with { post: relatedPost } only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
</article>
